# Copy to .env for local development. Never commit .env.

# --- Runtime environment ---
ENVIRONMENT=local

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dineops:dineops_dev_password@localhost:5432/dineops

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Observability (OpenTelemetry tracing) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=dineops
# console (default, no extra infra) | otlp (send to the Jaeger collector started by
# docker/docker-compose.observability.yml) | none (spans created but not exported)
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LLM provider (agent reasoning — Qwen3-8B via Ollama for local dev) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Embedding provider (MemoryService semantic search only — NOT the agent LLM, NOT RAG) ---
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
